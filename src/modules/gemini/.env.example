# Gemini AI Configuration
# ======================

# Required: Your Google Gemini API key
# Get it from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model configuration (with defaults)
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TOP_P=0.8
GEMINI_TOP_K=40

# Optional: Service configuration
GEMINI_ENABLE_LOGGING=true
GEMINI_TIMEOUT_MS=30000

# Model options available:
# - gemini-1.5-flash (recommended for speed)
# - gemini-1.5-pro (for complex tasks)
# - gemini-pro (legacy)

# Temperature: Controls randomness (0.0-1.0)
# - 0.0: Most deterministic
# - 0.2: Good for structured analysis (recommended)
# - 1.0: Most creative

# Max Output Tokens: Maximum response length
# - 2048: Good for most analyses
# - 4096: For detailed responses
# - 8192: For very long analyses
